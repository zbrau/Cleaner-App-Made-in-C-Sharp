<UserControl x:Class="AppCleanerPro.Views.RegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20">
            <InlineUIContainer><Image Source="pack://application:,,,/Assets/Icons/fi-rr-settings-window.png" Width="18" Height="18" VerticalAlignment="Center"/></InlineUIContainer>
            <Run Text=" Limpiador de Registro (Seguro)"/>
        </TextBlock>

        <!-- Controls -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Busca extensiones nulas, rutas inválidas y sobras. Es seguro." Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center"/>
                
                <Button Grid.Column="1" Height="35" Margin="20,0,0,0" Padding="14,0" Click="ScanBtn_Click" Style="{StaticResource ActionButton}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Escanear Registro" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" x:Name="FixBtn" Height="35" Margin="10,0,0,0" Padding="14,0"
                        Background="#DC2626" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="FixBtn_Click" IsEnabled="False" Opacity="0.5">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/Icons/fi-rr-trash.png" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Limpiar Todo" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- List -->
        <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="10">
            <Grid>
                <!-- Loading State Card -->
                <Border x:Name="LoadingCard" Background="#E60D1117" CornerRadius="10" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" MaxWidth="500" Panel.ZIndex="10">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Escaneando colmenas del Registro..." FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Analizando asociaciones vacías, extensiones y rutas huérfanas..." FontSize="12" Foreground="{DynamicResource TextSecond}" TextAlignment="Center" Margin="0,0,0,16"/>
                        <ProgressBar IsIndeterminate="True" Width="360" Height="4" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusLbl" Text="Presiona Escanear Registro para comenzar." 
                           Foreground="{DynamicResource TextSecond}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                           
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RegList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardHov}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Margin="0,2,0,4" Padding="15,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding RootKey}" Foreground="{DynamicResource AccentOrange}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0" Width="40" TextAlignment="Center"/>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecond}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
