<UserControl x:Class="AppCleanerPro.Views.FirewallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Loaded="UserControl_Loaded">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20">
            <InlineUIContainer><Image Source="pack://application:,,,/Assets/Icons/fi-rr-network-firewall.png" Width="18" Height="18" VerticalAlignment="Center"/></InlineUIContainer>
            <Run Text=" Reglas de Firewall (Visualizador)"/>
        </TextBlock>

        <!-- Controls -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchEntry" Height="35" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}" 
                         BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="12,0" VerticalContentAlignment="Center"
                         TextChanged="SearchEntry_TextChanged"/>
                
                <Button Grid.Column="1" Content="Cargar Reglas" Width="120" Height="35" Margin="20,0,0,0" Click="RefreshBtn_Click" Style="{StaticResource ActionButton}"/>
            </Grid>
        </Border>

        <!-- Rules List -->
        <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="10">
            <Grid>
                <TextBlock x:Name="StatusLbl" Text="Cargando reglas a través de la interfaz COM..." 
                           Foreground="{DynamicResource TextSecond}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RulesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardHov}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Margin="0,2,0,4" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Direction -->
                                        <Border Grid.Column="0" Background="{Binding DirectionColor}" CornerRadius="4" Padding="5,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Direction}" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                        </Border>

                                        <!-- Action -->
                                        <Border Grid.Column="1" Background="{Binding ActionColor}" CornerRadius="4" Padding="5,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Action}" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                        </Border>

                                        <!-- Name -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Protocol}" Foreground="{DynamicResource AccentViolet}" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
