<UserControl x:Class="AppCleanerPro.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20">
            <InlineUIContainer><Image Source="pack://application:,,,/Assets/Icons/fi-rr-privacy-settings.png" Width="18" Height="18" VerticalAlignment="Center"/></InlineUIContainer>
            <Run Text=" Escáner de Privacidad"/>
        </TextBlock>

        <!-- Controls -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PathEntry" Height="35" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}" 
                         BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="12,0" VerticalContentAlignment="Center"/>
                
                <Button Grid.Column="1" Height="35" Margin="10,0,0,0" Padding="14,0" Click="BrowseBtn_Click" Style="{StaticResource ActionButton}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/Icons/fi-rr-folder.png" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Explorar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Grid.Column="2" Height="35" Margin="20,0,0,0" Padding="16,0"
                        Background="{DynamicResource AccentOrange}" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="ScanBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Escanear" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Results List -->
        <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="10">
            <Grid>
                <!-- Loading State Card -->
                <Border x:Name="LoadingCard" Background="#E60D1117" CornerRadius="10" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" MaxWidth="500" Panel.ZIndex="10">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Escaneando archivos en busca de datos sensibles..." FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="PrivacyProgressText" Text="Analizando archivos de texto..." FontSize="12" Foreground="{DynamicResource TextSecond}" TextAlignment="Center" Margin="0,0,0,16"/>
                        <ProgressBar x:Name="PrivacyProgressBar" Width="360" Height="4" HorizontalAlignment="Center" Minimum="0" Maximum="100"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusLbl" Text="Presiona Escanear para buscar archivos de texto con posibles credenciales expuestas." 
                           Foreground="{DynamicResource TextSecond}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardHov}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Margin="0,2,0,4" Padding="15,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                                            <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource TextSecond}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="1" Text="{Binding MatchCount, StringFormat='\{0\} coincidencias'}" 
                                                   Foreground="{DynamicResource AccentOrange}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" 
                                                   Foreground="{DynamicResource AccentViolet}" VerticalAlignment="Center" Width="60" TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
