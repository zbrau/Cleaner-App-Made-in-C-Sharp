<UserControl x:Class="AppCleanerPro.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20">
            <Run Text="&#xE946;" FontFamily="Segoe MDL2 Assets"/>
            <Run Text=" Información del Sistema"/>
        </TextBlock>

        <!-- Loading state -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="30">
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Recopilando información de hardware..." Foreground="{DynamicResource TextSecond}" FontSize="16" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Info Grid (shown after load) -->
        <Grid x:Name="InfoGrid" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- OS -->
            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Image Source="pack://application:,,,/Assets/Icons/fi-rr-cpu.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Sistema Operativo" Foreground="{DynamicResource AccentBlue}" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="OsText" Text="Cargando..." Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ArchText" Text="Cargando..." Foreground="{DynamicResource TextSecond}" FontFamily="Segoe UI" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- CPU -->
            <Border Grid.Row="0" Grid.Column="1" Margin="10,0,0,10" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Image Source="pack://application:,,,/Assets/Icons/fi-rr-memory.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Procesador (CPU)" Foreground="{DynamicResource AccentGreen}" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="CpuText" Text="Cargando..." Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CoresText" Text="Cargando..." Foreground="{DynamicResource TextSecond}" FontFamily="Segoe UI" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- RAM -->
            <Border Grid.Row="1" Grid.Column="0" Margin="0,10,10,10" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Image Source="pack://application:,,,/Assets/Icons/fi-rr-memory.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Memoria RAM" Foreground="{DynamicResource AccentOrange}" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="RamText" Text="Cargando..." Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- GPU -->
            <Border Grid.Row="1" Grid.Column="1" Margin="10,10,0,10" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Image Source="pack://application:,,,/Assets/Icons/fi-rr-dashboard.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Gráficos (GPU)" Foreground="{DynamicResource AccentPink}" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="GpuText" Text="Cargando..." Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Motherboard -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Image Source="pack://application:,,,/Assets/Icons/fi-rr-data-processing.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Placa Base (Motherboard)" Foreground="{DynamicResource AccentBlue}" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="MoboText" Text="Cargando..." Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
