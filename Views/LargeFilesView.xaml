<UserControl x:Class="AppCleanerPro.Views.LargeFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <TextBlock Grid.Row="0" Text="Archivos Grandes"
                   Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"
                   FontSize="28" FontWeight="Bold" Margin="28,20,0,10"/>

        <!-- ── Controls Card ── -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="28,10,28,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PathEntry" Grid.Column="0"
                         Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}"
                         FontFamily="Segoe UI" FontSize="13" Padding="10,8"
                         BorderThickness="1" BorderBrush="{DynamicResource BorderCard}"
                         VerticalContentAlignment="Center" Margin="0,0,12,0"
                         Text="C:\"/>

                <TextBlock x:Name="StatusLbl" Grid.Column="1" Foreground="{DynamicResource AccentViolet}" FontFamily="Segoe UI" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,16,0" Text="Busca los top 100 archivos más grandes."/>

                <Button x:Name="ScanBtn" Grid.Column="2"
                        Click="ScanBtn_Click"
                        FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                        Foreground="#FFFFFF" Cursor="Hand" Padding="16,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource AccentBlue}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#4060CC" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png"
                                           Width="14" Height="14" Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Buscar Archivos" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── Results List ── -->
        <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="28,0,28,28" Padding="0,12,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="16,0,16,10">
                    <TextBlock Text="Los 100 archivos más pesados en la ruta" Foreground="{DynamicResource TextSecond}"
                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalSizeLbl" Text="Total recuperable: —" Foreground="{DynamicResource AccentGreen}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Animated Loading Card -->
                        <Border x:Name="ProgressRow"
                                CornerRadius="14"
                                Background="{DynamicResource BgCardHov}"
                                BorderBrush="{DynamicResource BorderCard}"
                                BorderThickness="1"
                                Padding="28,20"
                                Margin="32,40,32,0"
                                HorizontalAlignment="Center"
                                MinWidth="440"
                                MaxWidth="640"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png"
                                           Width="18" Height="18" Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="ScanStatusText" Text="Buscando archivos gigantes..."
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <ProgressBar IsIndeterminate="True" Height="8" Width="380"
                                             HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="ResultList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Background="{DynamicResource BgCardHov}"
                                            BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
                                            Margin="16,0,16,6" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Real Icon -->
                                            <Image Grid.Column="0" Source="pack://application:,,,/Assets/Icons/fi-rr-box.png"
                                                   Width="18" Height="18" Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <!-- Path and Name -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextSecond}" FontFamily="Segoe UI" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Size -->
                                            <TextBlock Grid.Column="2" Text="{Binding DisplaySize}"
                                                       Foreground="{DynamicResource AccentRed}" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                            <!-- Delete with real trash icon -->
                                            <Button Grid.Column="3" Tag="{Binding}" Click="Delete_Click"
                                                    Cursor="Hand" Padding="10,6" VerticalAlignment="Center"
                                                    ToolTip="Eliminar archivo">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Image Source="pack://application:,,,/Assets/Icons/fi-rr-trash.png"
                                                                       Width="13" Height="13" Margin="0,0,6,0"
                                                                       VerticalAlignment="Center"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <TextBlock Text="Eliminar" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</UserControl>
