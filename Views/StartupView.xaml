<UserControl x:Class="AppCleanerPro.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Loaded="UserControl_Loaded">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20">
            <InlineUIContainer><Image Source="pack://application:,,,/Assets/Icons/fi-rr-power.png" Width="18" Height="18" VerticalAlignment="Center"/></InlineUIContainer>
            <Run Text=" Gestor de Arranque (Startup)"/>
        </TextBlock>

        <!-- Controls -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Programas que se inician junto con Windows. Eliminar los innecesarios agiliza el PC." Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Height="35" Padding="14,0" Click="RefreshBtn_Click" Style="{StaticResource ActionButton}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/Icons/fi-rr-refresh.png"
                               Width="14" Height="14" Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Actualizar" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- List -->
        <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="StartupList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgCardHov}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Margin="0,2,0,4" Padding="15,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                                        <TextBlock Text="{Binding Command}" Foreground="{DynamicResource TextSecond}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="1" Text="{Binding Location}" 
                                               Foreground="{DynamicResource AccentBlue}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                                    <Button Grid.Column="2" CommandParameter="{Binding}" Click="DeleteBtn_Click"
                                            Height="30" Padding="12,0" Background="#DC2626" Foreground="White" 
                                            FontWeight="Bold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="pack://application:,,,/Assets/Icons/fi-rr-trash.png"
                                                               Width="12" Height="12" Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="Desactivar" Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
