<UserControl x:Class="AppCleanerPro.Views.CleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AppCleanerPro.Converters">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left: Category list ── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24,14,14,16">
            <StackPanel>

                <TextBlock Text="SELECCIONA LAS CATEGORÍAS A LIMPIAR"
                           Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI"
                           FontSize="10" FontWeight="SemiBold" Margin="2,0,0,10"/>

                <ItemsControl x:Name="CategoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Background="{DynamicResource BgCard}"
                                    BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
                                    Padding="16,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                              Checked="CheckBox_CheckedChanged" Unchecked="CheckBox_CheckedChanged"/>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon, Converter={StaticResource StrToImg}}" Width="18" Height="18"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource TextSecond}" FontFamily="Segoe UI"
                                                   FontSize="10" Margin="24,2,0,0"/>
                                    </StackPanel>

                                    <!-- Size (colored by code-behind via Tag trick) -->
                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                               FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentViolet}"
                                               VerticalAlignment="Center" Margin="12,0,16,0"
                                               MinWidth="80" TextAlignment="Right"/>

                                    <!-- Per-item clean button -->
                                    <Button Grid.Column="3"
                                            Tag="{Binding Key}"
                                            Click="CleanOne_Click"
                                            Cursor="Hand"
                                            Padding="10,6" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{DynamicResource BgCardHov}" CornerRadius="8"
                                                        BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="pack://application:,,,/Assets/Icons/fi-rr-trash.png"
                                                               Width="12" Height="12" Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="Limpiar" FontFamily="Segoe UI" FontSize="11"
                                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Right panel: summary + actions ── -->
        <StackPanel Grid.Column="1" Margin="0,20,28,28">

            <!-- Summary card -->
            <Border CornerRadius="16" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}"
                    BorderThickness="1" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="RESUMEN" Foreground="{DynamicResource TextMuted}"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Total seleccionado:" Foreground="{DynamicResource TextSecond}"
                               FontFamily="Segoe UI" FontSize="11"/>
                    <TextBlock x:Name="SelectedTotal" Text="—"
                               Foreground="{DynamicResource AccentViolet}" FontFamily="Segoe UI"
                               FontSize="28" FontWeight="Bold" Margin="0,4,0,10"/>
                    <Rectangle Height="1" Fill="{DynamicResource BorderCard}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Categorías:" Foreground="{DynamicResource TextSecond}"
                                   FontFamily="Segoe UI" FontSize="11"/>
                        <TextBlock x:Name="SelectedCatCount" Text="—"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Archivos:" Foreground="{DynamicResource TextSecond}"
                                   FontFamily="Segoe UI" FontSize="11"/>
                        <TextBlock x:Name="TotalFileCount" Text="—"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Scan button -->
            <Button x:Name="ScanBtn" Click="ScanBtn_Click"
                    Foreground="#FFFFFF" Cursor="Hand" Height="48" Margin="0,0,0,10">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource AccentBlue}" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#4060CC" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png"
                                       Width="16" Height="16" Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="ESCANEAR" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                           Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Clean button -->
            <Button x:Name="CleanBtn" Click="CleanBtn_Click"
                    IsEnabled="False"
                    Cursor="Hand" Height="44" Margin="0,0,0,10"
                    Opacity="0.45">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#DC2626" CornerRadius="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/Icons/fi-rr-trash.png"
                                       Width="16" Height="16" Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="LIMPIAR SELECCIONADO"
                                           FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                           Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Smart Optimize button -->
            <Button x:Name="SmartBtn" Click="SmartBtn_Click"
                    FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                    Foreground="#FFFFFF" Cursor="Hand" Height="44" Margin="0,0,0,10">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource AccentViolet}" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#7B3FCC" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/Icons/fi-rr-bolt.png" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SMART OPTIMIZE" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Deep DISM Windows Update Cleanup -->
            <Button x:Name="DismBtn" Click="DismBtn_Click"
                    Cursor="Hand" Height="38" Margin="0,0,0,12"
                    ToolTip="Limpia copias obsoletas de Windows Update en el almacén de componentes (WinSxS)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource BgCardHov}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/Icons/fi-rr-settings-window.png"
                                       Width="14" Height="14" Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="LIMPIEZA PROFUNDA DISM"
                                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Progress section -->
            <Border x:Name="ProgressSection" CornerRadius="12" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="16,12"
                    Visibility="Collapsed" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="CleanStatusLbl" Text="Escaneando…"
                                   Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="12"/>
                        <TextBlock x:Name="CleanPctLbl" Text=""
                                   Foreground="{DynamicResource AccentBlue}" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Background="{DynamicResource BgCardHov}" CornerRadius="4" Height="6">
                        <Border x:Name="CleanProgressBar" HorizontalAlignment="Left"
                                CornerRadius="4" Width="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#4060CC" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                </StackPanel>
            </Border>

            <!-- History card -->
            <Border CornerRadius="14" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}"
                    BorderThickness="1" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="HISTORIAL RECIENTE" Foreground="{DynamicResource TextMuted}"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Date}" Foreground="{DynamicResource TextSecond}"
                                               FontFamily="Segoe UI" FontSize="11"/>
                                    <TextBlock Text="{Binding SizeStr}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AccentGreen}" FontFamily="Segoe UI"
                                               FontSize="11" FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoHistoryText" Text="Sin historial aún"
                               Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" FontSize="11"
                               Visibility="Visible"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
