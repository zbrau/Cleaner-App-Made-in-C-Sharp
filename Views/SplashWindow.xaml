<Window x:Class="AppCleanerPro.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppCleaner"
        Height="380" Width="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border CornerRadius="20" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#060810" Offset="0"/>
                <GradientStop Color="#0A0D1C" Offset="0.5"/>
                <GradientStop Color="#080A14" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Glow background effect -->
            <Ellipse Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-80,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1A2A6040" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- App icon image -->
                <Border Width="100" Height="100" CornerRadius="28" Margin="0,0,0,16"
                        HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4060CC" Offset="0"/>
                            <GradientStop Color="#211A6B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#7B9FFF" BlurRadius="40" ShadowDepth="0" Opacity="0.7"/>
                    </Border.Effect>
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- App name -->
                <TextBlock Text="AppCleaner" FontFamily="Segoe UI" FontSize="32" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#7B9FFF" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text="Sistema de mantenimiento avanzado" FontFamily="Segoe UI" FontSize="13"
                           Foreground="#5A6280" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <!-- Loading bar -->
                <Border Width="280" Height="4" CornerRadius="2" Background="#1E2540" Margin="0,0,0,16">
                    <Border x:Name="LoadingBar" Width="0" HorizontalAlignment="Left" CornerRadius="2" MinWidth="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#4060CC" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="0.5"/>
                                <GradientStop Color="#34D399" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>

                <TextBlock x:Name="StatusText" Text="Iniciando..." FontFamily="Segoe UI" FontSize="11"
                           Foreground="#3A4060" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Version -->
            <TextBlock Text="v2.0" FontFamily="Segoe UI" FontSize="10"
                       Foreground="#2A3050" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,20,16"/>
        </Grid>
    </Border>
</Window>
