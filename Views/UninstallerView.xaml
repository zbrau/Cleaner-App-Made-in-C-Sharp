<UserControl x:Class="AppCleanerPro.Views.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Loaded="UserControl_Loaded">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20">
            <InlineUIContainer><Image Source="pack://application:,,,/Assets/Icons/fi-rr-trash.png" Width="18" Height="18" VerticalAlignment="Center"/></InlineUIContainer>
            <Run Text=" Desinstalador Profundo"/>
        </TextBlock>

        <!-- Controls -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchEntry" Height="35" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}" 
                         BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="12,0" VerticalContentAlignment="Center"
                         TextChanged="SearchEntry_TextChanged"/>
                
                <Button Grid.Column="1" Height="35" Margin="20,0,0,0" Padding="14,0" Click="RefreshBtn_Click" Style="{StaticResource ActionButton}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/Icons/fi-rr-refresh.png" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Recargar Apps" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- App List -->
        <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="10">
            <Grid>
                <!-- Loading State Card -->
                <Border x:Name="LoadingCard" Background="#E60D1117" CornerRadius="10" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" MaxWidth="500" Panel.ZIndex="10">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cargando aplicaciones instaladas..." FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Consultando desinstaladores y claves de registro..." FontSize="12" Foreground="{DynamicResource TextSecond}" TextAlignment="Center" Margin="0,0,0,16"/>
                        <ProgressBar IsIndeterminate="True" Width="360" Height="4" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AppList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardHov}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Margin="0,2,0,4" Padding="15,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                                            <TextBlock Text="{Binding Publisher}" Foreground="{DynamicResource TextSecond}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="1" CommandParameter="{Binding}" Click="UninstallBtn_Click"
                                                Height="32" Padding="12,0" Background="#DC2626" Foreground="White" 
                                                FontWeight="SemiBold" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Image Source="pack://application:,,,/Assets/Icons/fi-rr-trash.png" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Desinstalar" Foreground="White" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
