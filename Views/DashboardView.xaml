<UserControl x:Class="AppCleanerPro.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AppCleanerPro.Converters">

    <UserControl.Resources>
        <conv:StringToBrushConverter x:Key="StrBrush"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
        <StackPanel>

            <!-- ── Top metric row ── -->
            <UniformGrid Columns="3" Rows="1">

                <!-- Health Score card -->
                <Border CornerRadius="16" Margin="0,0,12,0" Padding="22,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D1A2A" Offset="0"/>
                            <GradientStop Color="#0A1320" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border BorderBrush="#1A3040" BorderThickness="1" CornerRadius="16" Padding="0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SALUD DEL SISTEMA" Foreground="#7B82A8"
                                       FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
                                <TextBlock x:Name="HealthScore"
                                           Text="—" Foreground="#34D399"
                                           FontSize="48" FontWeight="Bold" FontFamily="Segoe UI"/>
                                <TextBlock Text="/100" Foreground="#34D399" FontSize="20"
                                           FontFamily="Segoe UI" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                            </StackPanel>
                            <TextBlock x:Name="HealthLabel" Text="Calculando…"
                                       Foreground="#5A6280" FontSize="11" FontFamily="Segoe UI"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Junk Found card -->
                <Border CornerRadius="16" Margin="0,0,12,0" Padding="22,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A1020" Offset="0"/>
                            <GradientStop Color="#130C18" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border BorderBrush="#2A1A40" BorderThickness="1" CornerRadius="16" Padding="0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="BASURA ENCONTRADA" Foreground="#7B82A8"
                                       FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="JunkTotal" Text="—"
                                       Foreground="#A78BFA"
                                       FontSize="38" FontWeight="Bold" FontFamily="Segoe UI"
                                       Margin="0,10,0,6" TextAlignment="Center"/>
                            <TextBlock x:Name="JunkLabel" Text="Haz clic en ESCANEAR"
                                       Foreground="#5A6280" FontSize="11" FontFamily="Segoe UI"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Last clean card -->
                <Border CornerRadius="16" Padding="22,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#111A10" Offset="0"/>
                            <GradientStop Color="#0C1408" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border BorderBrush="#1A3018" BorderThickness="1" CornerRadius="16" Padding="0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="ÚLTIMA LIMPIEZA" Foreground="#7B82A8"
                                       FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="LastCleanSize" Text="—"
                                       Foreground="#34D399"
                                       FontSize="28" FontWeight="Bold" FontFamily="Segoe UI"
                                       Margin="0,10,0,6" TextAlignment="Center"/>
                            <TextBlock x:Name="LastCleanDate" Text="Sin historial"
                                       Foreground="#5A6280" FontSize="11" FontFamily="Segoe UI"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>
            </UniformGrid>

            <!-- ── Quick actions ── -->
            <Border CornerRadius="16" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
                    Padding="22,16" Margin="0,36,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mantén tu PC rápida y limpia" Foreground="{DynamicResource TextPrimary}"
                                   FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Escanea el sistema para encontrar archivos temporales, caché y basura."
                                   Foreground="{DynamicResource TextSecond}" FontSize="12" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DashScanBtn" Content="ESCANEAR AHORA"
                                Click="DashScanBtn_Click"
                                FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                Foreground="#FFFFFF" Cursor="Hand"
                                Padding="20,10" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource AccentBlue}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#4060CC" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="DashCleanBtn" Content="LIMPIAR TODO"
                                Click="DashCleanBtn_Click"
                                IsEnabled="False" Opacity="0.45"
                                FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                Foreground="#FFFFFF" Cursor="Hand"
                                Padding="20,10" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#8B2020" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="TurboBtn" Click="TurboBtn_Click"
                                FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                Foreground="#FFFFFF" Cursor="Hand"
                                Padding="20,10">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TurboBd" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#065F46" Offset="0"/>
                                                <GradientStop Color="#047857" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/Icons/fi-rr-bolt.png" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="MODO TURBO" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TurboBd" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ScanProgressRow" CornerRadius="10" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="22,12"
                    Visibility="Collapsed" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="ScanStatusText" Text="Escaneando…"
                                   Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="12"/>
                        <TextBlock x:Name="ScanPctText" Text="0%"
                                   Foreground="{DynamicResource AccentBlue}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Background="{DynamicResource BgCardHov}" CornerRadius="4" Height="6">
                        <Border x:Name="ScanProgressFill" HorizontalAlignment="Left" CornerRadius="4" Width="0"
                                MinWidth="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#4060CC" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Category cards grid ── -->
            <TextBlock Text="CATEGORÍAS" Foreground="{DynamicResource TextMuted}"
                       FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                       Margin="2,16,0,8"/>

            <UniformGrid x:Name="CategoryGrid" Columns="3"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
