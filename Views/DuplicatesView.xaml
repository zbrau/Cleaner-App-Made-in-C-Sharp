<UserControl x:Class="AppCleanerPro.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <TextBlock Grid.Row="0" Text="Archivos Duplicados"
                   Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"
                   FontSize="28" FontWeight="Bold" Margin="28,20,0,10"/>

        <!-- ── Controls Card ── -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="28,10,28,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PathEntry" Grid.Column="0"
                         Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}"
                         FontFamily="Segoe UI" FontSize="13" Padding="10,8"
                         BorderThickness="1" BorderBrush="{DynamicResource BorderCard}"
                         VerticalContentAlignment="Center" Margin="0,0,12,0"/>

                <TextBlock x:Name="StatusLbl" Grid.Column="1" Foreground="{DynamicResource AccentViolet}" FontFamily="Segoe UI" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,16,0" Text="Por defecto busca en la subcarpeta del usuario."/>

                <Button x:Name="ScanBtn" Grid.Column="2"
                        Click="ScanBtn_Click"
                        FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                        Foreground="#FFFFFF" Cursor="Hand" Padding="16,8" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource AccentBlue}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#4060CC" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png"
                                           Width="14" Height="14" Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Buscar Duplicados" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="CleanBtn" Grid.Column="3"
                        Click="CleanBtn_Click" IsEnabled="False" Opacity="0.45"
                        FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                        Foreground="#FFFFFF" Cursor="Hand" Padding="16,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#DC2626" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/Icons/fi-rr-trash.png"
                                           Width="14" Height="14" Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Limpiar Marcados" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── Results List ── -->
        <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="28,0,28,28" Padding="0,12,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="16,0,16,10">
                    <TextBlock Text="Grupos de archivos idénticos" Foreground="{DynamicResource TextSecond}"
                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalSizeLbl" Text="Total recuperable: —" Foreground="{DynamicResource AccentGreen}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Animated Loading Card -->
                        <Border x:Name="ProgressRow"
                                CornerRadius="14"
                                Background="{DynamicResource BgCardHov}"
                                BorderBrush="{DynamicResource BorderCard}"
                                BorderThickness="1"
                                Padding="28,20"
                                Margin="32,40,32,0"
                                HorizontalAlignment="Center"
                                MinWidth="440"
                                MaxWidth="640"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Image Source="pack://application:,,,/Assets/Icons/fi-rr-duplicate.png"
                                           Width="18" Height="18" Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="ScanStatusText" Text="Analizando firmas de archivos..."
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <ProgressBar IsIndeterminate="True" Height="8" Width="380"
                                             HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="ResultList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Background="{DynamicResource BgCardHov}"
                                            BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
                                            Margin="16,0,16,10" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Image Source="pack://application:,,,/Assets/Icons/fi-rr-duplicate.png"
                                                       Width="14" Height="14" Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource AccentViolet}" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Directory}" Foreground="{DynamicResource TextSecond}" FontFamily="Segoe UI" FontSize="10"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</UserControl>
