<UserControl x:Class="AppCleanerPro.Views.TreemapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <TextBlock Grid.Row="0" Text="Mapa de Disco (Treemap)"
                   Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"
                   FontSize="28" FontWeight="Bold" Margin="28,20,0,10"/>

        <!-- ── Controls Card ── -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="28,10,28,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackBtn" Grid.Column="0"
                        Click="BackBtn_Click" IsEnabled="False" Opacity="0.45"
                        FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}" Cursor="Hand" Padding="12,8" Margin="0,0,12,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource BgCardHov}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/Icons/fi-rr-angle-left.png" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Atrás" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBox x:Name="PathEntry" Grid.Column="1"
                         Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}"
                         FontFamily="Segoe UI" FontSize="13" Padding="10,8"
                         BorderThickness="1" BorderBrush="{DynamicResource BorderCard}"
                         VerticalContentAlignment="Center" Margin="0,0,12,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="StatusLbl" Foreground="{DynamicResource AccentViolet}" FontFamily="Segoe UI" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="420"
                               TextWrapping="Wrap"/>
                    
                    <Button x:Name="GenerateBtn"
                            Click="GenerateBtn_Click"
                            FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                            Foreground="#FFFFFF" Cursor="Hand" Padding="16,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{DynamicResource AccentGreen}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#10B981" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Generar Treemap" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Canvas Card ── -->
        <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="28,0,28,28" Padding="2">
            <Grid>
                <Canvas x:Name="TreemapCanvas" Background="{DynamicResource BgCard}" ClipToBounds="True" SizeChanged="TreemapCanvas_SizeChanged"/>
                
                <!-- Loading State Overlay -->
                <Border x:Name="LoadingCard" Background="#E60D1117" CornerRadius="10" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" MaxWidth="500" Panel.ZIndex="10">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Generando mapa visual del disco..." FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TreemapProgressText" Text="Escaneando archivos..." FontSize="12" Foreground="{DynamicResource TextSecond}" TextAlignment="Center" Margin="0,0,0,16" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                        <ProgressBar IsIndeterminate="True" Width="360" Height="4" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
