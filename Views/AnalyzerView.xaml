<UserControl x:Class="AppCleanerPro.Views.AnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <TextBlock Grid.Row="0" Text="Analizador de Espacio en Disco"
                   Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"
                   FontSize="28" FontWeight="Bold" Margin="28,20,0,10"/>

        <!-- ── Controls Card ── -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="28,10,28,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackBtn" Grid.Column="0"
                        Click="BackBtn_Click" IsEnabled="False" Opacity="0.45"
                        FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}" Cursor="Hand" Padding="12,8" Margin="0,0,12,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource BgCardHov}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/Icons/fi-rr-angle-left.png"
                                           Width="12" Height="12" Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Atrás" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBox x:Name="PathEntry" Grid.Column="1"
                         Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}"
                         FontFamily="Segoe UI" FontSize="13" Padding="10,8"
                         BorderThickness="1" BorderBrush="{DynamicResource BorderCard}"
                         VerticalContentAlignment="Center" Margin="0,0,12,0"/>

                <Button x:Name="AnalyzeBtn" Grid.Column="2"
                        Click="AnalyzeBtn_Click"
                        FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                        Foreground="#FFFFFF" Cursor="Hand" Padding="16,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource AccentBlue}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#4060CC" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png"
                                           Width="14" Height="14" Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Analizar Ruta" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── Results ── -->
        <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Margin="28,0,28,28" Padding="0,12,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,0,16,10">
                    <TextBlock Text="Uso por carpeta/archivo" Foreground="{DynamicResource TextSecond}"
                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalSizeLbl" Text="Total: 0 MB" Foreground="{DynamicResource AccentGreen}"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Animated Loading Card with Progress Bar -->
                        <Border x:Name="LoadingCard"
                                CornerRadius="14"
                                Background="{DynamicResource BgCardHov}"
                                BorderBrush="{DynamicResource BorderCard}"
                                BorderThickness="1"
                                Padding="28,24"
                                Margin="32,40,32,0"
                                HorizontalAlignment="Center"
                                MinWidth="460"
                                MaxWidth="680"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Image Source="pack://application:,,,/Assets/Icons/fi-rr-search.png"
                                           Width="18" Height="18" Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="LoadingTitle" Text="Analizando espacio en disco..."
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Name="LoadingDetail" Text="Explorando estructura de carpetas..."
                                           Foreground="{DynamicResource TextSecond}"
                                           FontFamily="Segoe UI" FontSize="12"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="550" Margin="0,0,0,16"/>

                                <ProgressBar IsIndeterminate="True" Height="8" Width="420"
                                             HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <ItemsControl x:Name="ResultList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Background="{DynamicResource BgCardHov}"
                                            BorderBrush="{DynamicResource BorderCard}" BorderThickness="1"
                                            Margin="16,0,16,6" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Real Icon -->
                                            <Image Grid.Column="0" Source="{Binding IconPath}"
                                                   Width="16" Height="16" Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <!-- Name -->
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"
                                                       FontSize="13" FontWeight="Bold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <!-- Open button (only for Dirs) -->
                                            <Button Grid.Column="2"
                                                    Tag="{Binding Path}" Click="OpenDir_Click"
                                                    Visibility="{Binding OpenVis}"
                                                    FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource AccentBlue}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Abrir" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                                            <Image Source="pack://application:,,,/Assets/Icons/fi-rr-angle-right.png"
                                                                   Width="10" Height="10" Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Progress Bar -->
                                            <Border Grid.Column="3" Background="{DynamicResource BgDeep}" CornerRadius="4" Height="8" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource AccentViolet}"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>

                                            <!-- Size -->
                                            <TextBlock Grid.Column="4" Text="{Binding DisplaySize}"
                                                       Foreground="{DynamicResource TextSecond}" FontFamily="Segoe UI" FontSize="12"
                                                       Width="70" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                            <!-- Delete with real trash icon -->
                                            <Button Grid.Column="5" Tag="{Binding}" Click="Delete_Click"
                                                    Cursor="Hand" Padding="8,6" VerticalAlignment="Center"
                                                    ToolTip="Eliminar permanentemente">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#DC2626" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <Image Source="pack://application:,,,/Assets/Icons/fi-rr-trash.png"
                                                                   Width="14" Height="14"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</UserControl>
