<UserControl x:Class="AppCleanerPro.Views.ShredderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20">
            <InlineUIContainer><Image Source="pack://application:,,,/Assets/Icons/fi-rr-shredder.png" Width="18" Height="18" VerticalAlignment="Center"/></InlineUIContainer>
            <Run Text=" Destructor de Archivos (Shredder)"/>
        </TextBlock>

        <!-- Controls -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Destino:" Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="PathEntry" Grid.Column="1" Height="35" Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}" 
                             BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Height="35" Margin="10,0,0,0" Padding="12,0" Click="BrowseFileBtn_Click" Style="{StaticResource ActionButton}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/Icons/fi-rr-document.png" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Archivo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Height="35" Margin="10,0,0,0" Padding="12,0" Click="BrowseFolderBtn_Click" Style="{StaticResource ActionButton}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/Icons/fi-rr-folder.png" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Carpeta" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Pases militares (DoD):" Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="PassesCombo" Grid.Column="1" Width="70" Height="35" SelectedIndex="1">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="7"/>
                    </ComboBox>

                    <Button Grid.Column="2" Width="140" Height="35" Margin="15,0,0,0" Background="#DC2626" Foreground="White" 
                            FontWeight="Bold" Cursor="Hand" Click="ShredFileBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/fi-rr-shredder.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="TRITURAR ARCHIVO"/>
                        </StackPanel>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Grid.Column="3" Width="150" Height="35" Margin="10,0,0,0" Background="#991B1B" Foreground="White" 
                            FontWeight="Bold" Cursor="Hand" Click="ShredFolderBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/fi-rr-trash.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="TRITURAR CARPETA"/>
                        </StackPanel>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="20,0,0,0">
                        <ProgressBar x:Name="ShredProgressBar" IsIndeterminate="True" Height="4" Margin="0,0,0,6" Visibility="Collapsed"/>
                        <TextBlock x:Name="ResultLbl" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Log List -->
        <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderCard}" BorderThickness="1" Padding="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LogList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentViolet}" FontFamily="Consolas" FontSize="12" Margin="10,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
